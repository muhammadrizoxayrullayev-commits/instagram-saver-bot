# Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Admin Telegram ID lari (vergul bilan ajratilgan, ixtiyoriy)
ADMIN_IDS=123456789

# Yuklab olinadigan videolarning maksimal hajmi (MB larda, Telegram odatda 50MB gacha bot orqali ruxsat beradi)
MAX_FILE_SIZE_MB=50

# Keshda vaqtinchalik saqlash vaqti (daqiqalarda)
TEMP_EXPIRE_MINUTES=15
